{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "environmentName": {
            "value": "${AZURE_ENV_NAME}"
        },
        "location": {
            "value": "${AZURE_LOCATION=eastus2}"
        },
        "backendContainerImage": {
            "value": "${SERVICE_API_IMAGE_NAME}"
        },
        "frontendContainerImage": {
            "value": "${SERVICE_WEB_IMAGE_NAME}"
        },
        "projectName": {
            "value": "insurance-multi-agent"
        },
        "azureOpenAIDeploymentName": {
            "value": "${AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini}"
        },
        "azureOpenAIEmbeddingModel": {
            "value": "${AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-large}"
        },
        "azureOpenAIModelVersion": {
            "value": "${AZURE_OPENAI_MODEL_VERSION=2025-04-14}"
        },
        "searchServiceLocation": {
            "value": "${AZURE_SEARCH_LOCATION=}"
        },
        "existingFoundryProjectEndpoint": {
            "value": "${AZURE_AI_PROJECT=}"
        },
        "useAzureAgents": {
            "value": "${USE_AZURE_AGENTS=false}"
        },
        "useFoundryAgents": {
            "value": "${USE_FOUNDRY_AGENTS=false}"
        },
        "foundryAgentModel": {
            "value": "${FOUNDRY_AGENT_MODEL=}"
        },
        "fabricConnectionName": {
            "value": "${FABRIC_CONNECTION_NAME=}"
        },
        "fabricCapacitySkuName": {
            "value": "${FABRIC_CAPACITY_SKU=F2}"
        },
        "fabricCapacityAdminMember": {
            "value": "${FABRIC_CAPACITY_ADMIN_MEMBER=}"
        }
    }
}